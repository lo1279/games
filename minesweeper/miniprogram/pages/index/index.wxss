/** pages/index/index.wxss **/

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100vw;
  background-color: #0b0f19;
  background-image: 
    radial-gradient(circle at 50% 5%, rgba(56, 189, 248, 0.1) 0%, transparent 40%),
    radial-gradient(circle at 80% 85%, rgba(239, 68, 68, 0.08) 0%, transparent 40%);
  overflow: hidden;
  box-sizing: border-box;
}

/* 顶部工具栏 */
.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 24rpx;
  background: rgba(22, 30, 46, 0.7);
  backdrop-filter: blur(10px);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  flex-shrink: 0;
}

.toolbar-left, .toolbar-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tool-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #1e293b;
  color: #f8fafc;
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  border: 1rpx solid #334155;
}

.picker-btn .arrow {
  font-size: 18rpx;
  color: #94a3b8;
  margin-left: 4rpx;
}

/* HUD 仪表盘 */
.hud-panel {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 12rpx 24rpx;
  padding: 12rpx 24rpx;
  background: #030712;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  flex-shrink: 0;
}

.led-display {
  font-family: "Courier New", Courier, monospace;
  font-size: 44rpx;
  font-weight: 900;
  background: #111827;
  color: #ef4444;
  text-shadow: 0 0 12rpx rgba(239, 68, 68, 0.6);
  padding: 4rpx 20rpx;
  border-radius: 6rpx;
  letter-spacing: 4rpx;
  min-width: 140rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.smiley-btn {
  width: 76rpx;
  height: 76rpx;
  background: #1e293b;
  border: 2rpx solid #475569;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.4);
}

.btn-active {
  transform: scale(0.92);
}

.smiley-icon {
  font-size: 40rpx;
}

/* 可缩放与平移的棋盘容器 */
.board-area {
  flex: 1;
  width: 100vw;
  position: relative;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.25);
}

.board-view {
  width: max-content;
  height: max-content;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
}

.board-grid {
  display: grid;
  gap: 3rpx;
  background: rgba(15, 23, 42, 0.85);
  padding: 8rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.6);
}

/* 单元格 */
.cell {
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 28rpx;
  border-radius: 6rpx;
  box-sizing: border-box;
}

/* 隐藏格 */
.cell-hidden {
  background: #1e293b;
  border: 1rpx solid #334155;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.15), 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

/* 翻开格 */
.cell-revealed {
  background: #0f172a;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
}

.cell-mine {
  background: #450a0a !important;
  border-color: #ef4444 !important;
}

.cell-exploded {
  background: #dc2626 !important;
}

.cell-false-flag {
  background: #475569 !important;
}

/* 数字颜色 */
.num-1 { color: #38bdf8; }
.num-2 { color: #4ade80; }
.num-3 { color: #f87171; }
.num-4 { color: #c084fc; }
.num-5 { color: #fb923c; }
.num-6 { color: #2dd4bf; }
.num-7 { color: #f472b6; }
.num-8 { color: #94a3b8; }

/* 底部操作模式切换栏 */
.mode-bar {
  display: flex;
  justify-content: space-around;
  padding: 14rpx 24rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(15, 23, 42, 0.92);
  backdrop-filter: blur(16px);
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  gap: 20rpx;
  flex-shrink: 0;
}

.mode-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #1e293b;
  border: 2rpx solid #334155;
  transition: all 0.2s ease;
}

.mode-icon {
  font-size: 38rpx;
}

.mode-texts {
  display: flex;
  flex-direction: column;
}

.mode-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #94a3b8;
}

.mode-sub {
  font-size: 18rpx;
  color: #64748b;
  margin-top: 2rpx;
}

/* 激活状态 */
.reveal-active {
  background: rgba(56, 189, 248, 0.15) !important;
  border-color: #38bdf8 !important;
  box-shadow: 0 0 16rpx rgba(56, 189, 248, 0.3);
}

.reveal-active .mode-title {
  color: #38bdf8 !important;
}

.flag-active {
  background: rgba(239, 68, 68, 0.15) !important;
  border-color: #ef4444 !important;
  box-shadow: 0 0 16rpx rgba(239, 68, 68, 0.3);
}

.flag-active .mode-title {
  color: #ef4444 !important;
}

/* 弹窗遮罩 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  background: #111827;
  border: 1rpx solid #374151;
  border-radius: 16rpx;
  width: 82vw;
  padding: 36rpx;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.8);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  color: #f8fafc;
  margin-bottom: 28rpx;
}

.records-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 20rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 8rpx;
  font-size: 26rpx;
}

.record-label {
  color: #cbd5e1;
}

.record-val {
  color: #38bdf8;
  font-weight: 700;
}

.win-detail {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #cbd5e1;
  margin-bottom: 30rpx;
}

.win-time {
  font-size: 34rpx;
  color: #38bdf8;
  font-weight: 800;
}

.modal-buttons {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.btn {
  flex: 1;
  padding: 16rpx 0;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 10rpx;
  border: none;
  line-height: 1.4;
}

.btn-primary {
  background: #2563eb;
  color: #ffffff;
}

.btn-secondary {
  background: #334155;
  color: #e2e8f0;
}
