/* pages/games/thunder-fighter/index.wxss */
page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background-color: #060913;
}

.game-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: radial-gradient(circle at 50% 30%, #0d1527 0%, #05070f 100%);
  user-select: none;
}

.game-canvas {
  width: 100vw;
  height: 100vh;
  display: block;
}

/* 顶部 HUD */
.hud-top {
  position: absolute;
  top: 40rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  pointer-events: none;
  z-index: 10;
}

.hud-item {
  display: flex;
  align-items: center;
  background: rgba(10, 16, 32, 0.75);
  border: 1px solid rgba(0, 240, 255, 0.25);
  backdrop-filter: blur(8px);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

.hud-label {
  font-size: 22rpx;
  color: #8fa0c0;
  margin-right: 12rpx;
}

.hud-val {
  font-size: 28rpx;
  font-weight: bold;
  color: #00f0ff;
  font-family: monospace;
}

.health-box {
  flex: 0.6;
  margin: 0 16rpx;
}

.hp-bar-bg {
  flex: 1;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  overflow: hidden;
}

.hp-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff0055, #ffaa00, #00ff88);
  border-radius: 8rpx;
  transition: width 0.2s ease;
}

.pause-box {
  pointer-events: auto;
  cursor: pointer;
}

.hud-btn {
  font-size: 28rpx;
  color: #00f0ff;
}

/* 底部触控面板 */
.hud-bottom {
  position: absolute;
  bottom: 50rpx;
  right: 40rpx;
  z-index: 10;
}

.bomb-btn {
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  border-radius: 40rpx;
  backdrop-filter: blur(10px);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.4);
  transition: transform 0.1s, opacity 0.2s;
}

.bomb-btn:active {
  transform: scale(0.92);
}

.bomb-active {
  background: linear-gradient(135deg, rgba(255, 0, 85, 0.7), rgba(255, 102, 0, 0.8));
  border: 1px solid #ff4488;
  color: #ffffff;
}

.bomb-disabled {
  background: rgba(30, 40, 60, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #667799;
  opacity: 0.5;
}

.bomb-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.bomb-text {
  font-size: 26rpx;
  font-weight: 600;
}

/* 弹窗遮罩 */
.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(3, 6, 15, 0.85);
  backdrop-filter: blur(10px);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
}

.modal-card {
  width: 80%;
  background: #0d1527;
  border: 1px solid rgba(0, 240, 255, 0.4);
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 10rpx 40rpx rgba(0, 240, 255, 0.15);
}

.modal-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}

.modal-body {
  margin-bottom: 36rpx;
}

.modal-score {
  font-size: 30rpx;
  color: #a0b0d0;
  margin: 12rpx 0;
}

.highlight {
  color: #00f0ff;
  font-weight: bold;
  font-size: 34rpx;
}

.modal-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  width: 100%;
  font-size: 28rpx;
  border-radius: 36rpx;
  padding: 16rpx 0;
}

.btn-primary {
  background: linear-gradient(90deg, #00f0ff, #0077ff);
  color: #ffffff;
  border: none;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.08);
  color: #8fa0c0;
  border: 1px solid rgba(255, 255, 255, 0.2);
}
