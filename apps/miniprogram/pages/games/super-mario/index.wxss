/* pages/games/super-mario/index.wxss */
page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background-color: #000000;
  user-select: none;
}

.mario-container {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  background: #000000;
  position: relative;
}

/* NES 顶部 HUD */
.nes-hud {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 20rpx;
  background: #000000;
  border-bottom: 2rpx solid #222222;
  z-index: 10;
}

.hud-col {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hud-title {
  font-size: 22rpx;
  font-weight: bold;
  color: #fc9838;
  font-family: monospace;
}

.hud-value {
  font-size: 26rpx;
  font-weight: bold;
  color: #ffffff;
  font-family: monospace;
  margin-top: 4rpx;
}

/* 画布承载容器 (保持 4:3 或 NES 256:240 比例) */
.canvas-wrapper {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #5c94fc; /* 原版天蓝色 */
  overflow: hidden;
}

.mario-canvas {
  width: 100%;
  height: 100%;
  image-rendering: pixelated;
}

/* 底部虚拟手柄 */
.gamepad-area {
  height: 280rpx;
  background: #111111;
  border-top: 4rpx solid #282828;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 40rpx;
  box-sizing: border-box;
}

/* 十字方向键 */
.dpad-box {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.dpad-btn {
  width: 96rpx;
  height: 96rpx;
  background: #2a2a2a;
  border: 2rpx solid #444444;
  border-radius: 18rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 6rpx 0 #181818;
}

.dpad-btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 #181818;
  background: #3a3a3a;
}

.btn-arrow {
  font-size: 36rpx;
  color: #dddddd;
}

/* 右侧动作按键 (NES 红色双键) */
.action-box {
  display: flex;
  gap: 32rpx;
  align-items: center;
}

.nes-btn {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: 0 6rpx 0 #600000;
}

.nes-btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 #600000;
}

.btn-b {
  background: linear-gradient(135deg, #cc2200, #991100);
}

.btn-a {
  background: linear-gradient(135deg, #ee1100, #aa0000);
}

.btn-label {
  font-size: 34rpx;
  font-weight: bold;
  color: #ffffff;
  font-family: monospace;
}

.btn-sub {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 结算弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-card {
  width: 80%;
  background: #1a1a1a;
  border: 4rpx solid #fc9838;
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
}

.modal-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #fc9838;
  margin-bottom: 16rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: #aaaaaa;
  margin-bottom: 24rpx;
}

.modal-score {
  font-size: 32rpx;
  color: #ffffff;
  margin-bottom: 36rpx;
}

.score-highlight {
  color: #fc9838;
  font-weight: bold;
}

.modal-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  width: 100%;
  font-size: 28rpx;
  border-radius: 30rpx;
}

.btn-restart {
  background: #fc9838;
  color: #000000;
  font-weight: bold;
}

.btn-exit {
  background: #333333;
  color: #ffffff;
}
