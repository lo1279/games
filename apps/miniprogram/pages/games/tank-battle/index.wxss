/* pages/games/tank-battle/index.wxss - 战场军事绿主题 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #0a0b12;
  box-sizing: border-box;
  padding: 12rpx 12rpx env(safe-area-inset-bottom);
}

/* ===== 顶部 HUD ===== */
.topbar {
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  padding: 8rpx 4rpx;
}

.hud-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(34, 197, 94, 0.25);
  border-radius: 16rpx;
  padding: 8rpx 4rpx;
}

.hud-label {
  font-size: 20rpx;
  color: #94a3b8;
  margin-bottom: 4rpx;
  letter-spacing: 2rpx;
}

.hud-val {
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 0 12rpx rgba(34, 197, 94, 0.7);
  font-variant-numeric: tabular-nums;
}

/* ===== 战场 ===== */
.board-area {
  flex: 1;
  height: 0;
  min-height: 0;
  overflow: hidden;
  position: relative;
  margin: 10rpx 0;
  background: #000;
  border: 1rpx solid rgba(34, 197, 94, 0.25);
  border-radius: 18rpx;
}

.board-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* ===== 遮罩 ===== */
.overlay {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(6, 7, 13, 0.82);
  backdrop-filter: blur(4px);
}

.overlay-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  padding: 40rpx 48rpx;
}

.overlay-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 0 16rpx rgba(34, 197, 94, 0.9);
}

.overlay-sub {
  font-size: 24rpx;
  color: #94a3b8;
}

.overlay-btn {
  margin-top: 10rpx;
  padding: 20rpx 56rpx;
  background: linear-gradient(135deg, #22c55e, #16a34a);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 24rpx rgba(34, 197, 94, 0.45);
}

.overlay-btn-active {
  opacity: 0.82;
  transform: scale(0.96);
}

/* ===== 底部控制 ===== */
.controls {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 6rpx 2rpx 0;
}

/* 方向盘 3 列网格 */
.dpad {
  display: grid;
  grid-template-columns: repeat(3, 96rpx);
  grid-template-rows: repeat(2, 96rpx);
  gap: 10rpx;
}

.dpad-empty {
  visibility: hidden;
}

.dpad-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #e2e8f0;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(148, 163, 184, 0.25);
  border-radius: 16rpx;
  user-select: none;
}

.dpad-active {
  background: rgba(34, 197, 94, 0.22);
  border-color: rgba(34, 197, 94, 0.55);
  transform: scale(0.94);
}

/* 动作键 */
.actions {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  padding-left: 12rpx;
}

.fire-btn {
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  background: rgba(34, 197, 94, 0.16);
  border: 1rpx solid rgba(34, 197, 94, 0.5);
  border-radius: 18rpx;
  user-select: none;
}

.fire-active {
  background: rgba(34, 197, 94, 0.32);
  transform: scale(0.96);
}

.act-row {
  display: flex;
  gap: 12rpx;
}

.act-btn {
  flex: 1;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  color: #e2e8f0;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(148, 163, 184, 0.25);
  border-radius: 16rpx;
  user-select: none;
}

.act-active {
  background: rgba(34, 197, 94, 0.22);
  border-color: rgba(34, 197, 94, 0.55);
  transform: scale(0.96);
}
