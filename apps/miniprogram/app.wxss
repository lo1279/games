/**
 * app.wxss - 全局样式
 * 提取原 Web 版 hall.css 的设计令牌（暗黑赛博 + 玻璃拟态），
 * 供各页面通过 class 复用，保持视觉一致性。
 */

page {
  background: #0a0c14;
  color: #e8ecf8;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  /* 禁止页面整体横向滚动，卡片网格自行处理溢出 */
  overflow-x: hidden;
}

view, text, scroll-view, button, input {
  box-sizing: border-box;
}

/* ===== 设计令牌 ===== */
.page-bg {
  min-height: 100vh;
  background:
    radial-gradient(circle at 15% 8%, rgba(99, 102, 241, 0.16) 0%, transparent 42%),
    radial-gradient(circle at 85% 22%, rgba(236, 72, 153, 0.12) 0%, transparent 45%),
    linear-gradient(180deg, #0a0c14 0%, #0d1020 55%, #0a0c14 100%);
}

/* 玻璃拟态面板 */
.glass-panel {
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 28rpx;
}

/* ===== 通用按钮 ===== */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
  box-shadow: 0 12rpx 32rpx rgba(99, 102, 241, 0.32);
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  color: #c7d0e8;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.btn-ghost::after {
  border: none;
}

/* 隐藏滚动条但保留滚动能力 */
::-webkit-scrollbar {
  display: none;
}