/* pages/index/index.wxss - 游戏大厅首页样式
 * 设计基调沿用 Web 版 hall.css：暗黑赛博 + 玻璃拟态
 * 单位统一用 rpx，兼容不同机型宽度
 */

/* ===== 顶部统计 ===== */
.hub-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 24rpx 32rpx 0;
  padding: 22rpx 0;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.stat-item {
  display: flex;
  align-items: baseline;
  flex: 1;
  justify-content: center;
}

.stat-label {
  font-size: 22rpx;
  color: #8b95b5;
  margin: 0 4rpx;
}

.stat-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #e8ecf8;
  margin: 0 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 32rpx;
  background: rgba(255, 255, 255, 0.1);
}

/* ===== Hero ===== */
.hero {
  margin: 28rpx 32rpx 0;
  padding: 40rpx 36rpx;
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 20% 0%, rgba(99, 102, 241, 0.28) 0%, transparent 58%),
    radial-gradient(circle at 88% 100%, rgba(236, 72, 153, 0.2) 0%, transparent 52%),
    rgba(255, 255, 255, 0.035);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
}

.hero-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 22rpx;
  font-size: 21rpx;
  color: #c7d2fe;
  background: rgba(99, 102, 241, 0.2);
  border: 1rpx solid rgba(129, 140, 248, 0.32);
}

.hero-title {
  display: block;
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: #97a1c0;
}

.hero-actions {
  margin-top: 30rpx;
}

.hero-btn {
  width: 100%;
}

/* ===== 分类 Tab ===== */
.category-tabs {
  width: 100%;
  margin-top: 28rpx;
  white-space: nowrap;
}

.tabs-inner {
  display: inline-flex;
  align-items: center;
  padding: 0 32rpx;
}

.tab-item {
  flex-shrink: 0;
  margin-right: 16rpx;
  padding: 14rpx 30rpx;
  border-radius: 34rpx;
  font-size: 25rpx;
  color: #97a1c0;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  transition: all 0.2s;
}

.tab-active {
  color: #ffffff;
  background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
  border-color: transparent;
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.35);
}

.tab-text {
  font-size: 25rpx;
}

/* ===== 搜索 + 排序 ===== */
.toolbar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx 0;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 22rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.055);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #e8ecf8;
}

.search-placeholder {
  color: #6b7694;
  font-size: 26rpx;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 22rpx;
  color: #97a1c0;
  background: rgba(255, 255, 255, 0.1);
}

.sort-picker {
  margin-left: 16rpx;
}

.sort-btn {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 22rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.055);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
}

.sort-text {
  font-size: 24rpx;
  color: #c7d0e8;
}

.sort-arrow {
  font-size: 18rpx;
  color: #6b7694;
  margin-left: 8rpx;
}

/* ===== 卡片网格 ===== */
.games-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx 24rpx 0;
}

.game-card {
  position: relative;
  width: 334rpx;
  margin: 8rpx;
  padding: 26rpx 24rpx 22rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-sizing: border-box;
  overflow: hidden;
}

/* 未移植游戏降饱和处理 */
.card-locked {
  opacity: 0.55;
}

.card-lock-badge {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  display: flex;
  align-items: center;
  padding: 5rpx 14rpx;
  border-radius: 18rpx;
  background: rgba(251, 191, 36, 0.16);
  border: 1rpx solid rgba(251, 191, 36, 0.34);
}

.lock-icon {
  font-size: 18rpx;
  margin-right: 5rpx;
}

.lock-text {
  font-size: 18rpx;
  color: #fcd34d;
}

.fav-btn {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.32);
}

/* 已收藏时徽章右移，避开「移植中」角标 */
.fav-active {
  top: 88rpx;
}

.fav-icon {
  font-size: 26rpx;
}

.card-head {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}

.card-icon {
  font-size: 54rpx;
  margin-right: 16rpx;
  line-height: 1;
}

.card-title-box {
  flex: 1;
  /* 预留右侧收藏按钮空间，避免标题被遮挡 */
  padding-right: 64rpx;
  overflow: hidden;
}

.card-title {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  color: #f2f5ff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-en {
  display: block;
  margin-top: 5rpx;
  font-size: 19rpx;
  color: #6b7694;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-summary {
  display: block;
  margin-top: 18rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #97a1c0;
  /* 统一裁剪为两行，保证卡片等高 */
  height: 74rpx;
  overflow: hidden;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  height: 52rpx;
  overflow: hidden;
}

.card-tag {
  margin: 0 8rpx 8rpx 0;
  padding: 5rpx 14rpx;
  border-radius: 14rpx;
  font-size: 19rpx;
  color: #a5b4fc;
  background: rgba(99, 102, 241, 0.14);
  border: 1rpx solid rgba(99, 102, 241, 0.24);
}

.card-foot {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.card-rating {
  font-size: 21rpx;
  color: #fbbf24;
}

.card-plays {
  margin-left: 12rpx;
  font-size: 19rpx;
  color: #6b7694;
}

.card-action {
  margin-left: auto;
  padding: 7rpx 18rpx;
  border-radius: 22rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 84rpx;
}

.empty-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #6b7694;
}

.footer-note {
  padding: 40rpx 0 56rpx;
  text-align: center;
  font-size: 21rpx;
  color: #565f7a;
}

/* ===== 详情弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(4, 6, 14, 0.78);
}

.modal-panel {
  position: relative;
  width: 100%;
  max-height: 80vh;
  padding: 40rpx 36rpx 36rpx;
  border-radius: 32rpx;
  background: linear-gradient(160deg, #141830 0%, #0d1020 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  overflow-y: auto;
}

.modal-close {
  position: absolute;
  top: 24rpx;
  right: 26rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 26rpx;
  color: #97a1c0;
  background: rgba(255, 255, 255, 0.08);
}

.modal-head {
  display: flex;
  align-items: center;
  padding-right: 72rpx;
}

.modal-icon {
  font-size: 68rpx;
  margin-right: 20rpx;
}

.modal-head-text {
  flex: 1;
  overflow: hidden;
}

.modal-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #ffffff;
}

.modal-en {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #6b7694;
}

.modal-section {
  margin-top: 30rpx;
}

.modal-section-title {
  display: block;
  font-size: 23rpx;
  font-weight: 600;
  color: #a5b4fc;
  margin-bottom: 12rpx;
}

.modal-desc,
.modal-controls {
  display: block;
  font-size: 24rpx;
  line-height: 1.7;
  color: #b3bcd6;
}

.modal-features {
  display: flex;
  flex-direction: column;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.feature-dot {
  font-size: 22rpx;
  color: #6366f1;
  margin-right: 10rpx;
  line-height: 1.6;
}

.feature-text {
  flex: 1;
  font-size: 23rpx;
  line-height: 1.6;
  color: #b3bcd6;
}

.modal-fav-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.045);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.modal-fav-icon {
  font-size: 30rpx;
  margin-right: 10rpx;
}

.modal-fav-text {
  font-size: 25rpx;
  color: #c7d0e8;
}

.modal-play {
  margin-top: 24rpx;
}