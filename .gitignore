# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Testing
coverage/

# Production (build artifacts — 标准 Monorepo 治理：构建产物不入库)
# Vite 三游戏构建产物：发布前本地 npm run build 重生，不纳入版本控制
subgames/life-simulator/dist/
subgames/mythology-deckbuilder/dist/
subgames/three-kingdoms-td/dist/
**/dist/

# 云端发布产物（由 tools/build.sh 生成：apps/web-hall + subgames → dist/）
# 纯生成物，不入库；需要发布时本地跑一次脚本重建即可
dist/

# WorkBuddy 工作数据（全部不入库）
# .workbuddy/memory/   每日工作日志与跨会话决策链
# .workbuddy/reports/  调研报告、台账、分析结论等与项目代码无关的产出
# 这些是过程记录，不是项目资产；保留在本地，不污染仓库
.workbuddy/

# WorkBuddy 应用标记（发布工具自动生成，属于工具元数据而非项目代码）
# 文件本身保留在本地，删掉会导致应用管理失效；只是不入库
.wbapp_*.genie
.wbapp_*.privacy.json

